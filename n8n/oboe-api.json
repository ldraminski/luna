  {
   "id": "35df1cb3-44a8-48aa-b641-fb566b857f3b",
   "name": "GET me",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    400
   ],
   "webhookId": "7f5a6841-59e7-42a1-94ef-94ecf10b67e1",
   "parameters": {
    "httpMethod": "GET",
    "path": "oboe/me",
    "responseMode": "responseNode",
    "options": {}
   }
  },
  {
   "id": "bd73e843-da67-4191-84ff-b226fb14dd9e",
   "name": "Kim jestem",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.6,
   "position": [
    240,
    400
   ],
   "credentials": {
    "postgres": {
     "id": "IAfnl61Lb7KbTeZi",
     "name": "Oboe - Postgres (oboe-db)"
    }
   },
   "alwaysOutputData": false,
   "parameters": {
    "operation": "executeQuery",
    "query": "WITH me AS (\n  UPDATE sessions SET expires_at = greatest(expires_at, now() + interval '30 days')\n  WHERE token_hash = encode(digest($1, 'sha256'), 'hex') AND expires_at > now()\n  RETURNING user_id)\nSELECT CASE WHEN NOT EXISTS (SELECT 1 FROM me) THEN json_build_object('status', 401, 'error', 'Zaloguj się ponownie')\n  ELSE (SELECT json_build_object('status', 200, 'user', json_build_object('email', u.email, 'name', u.name))\n        FROM users u WHERE u.id = (SELECT user_id FROM me)) END AS result",
    "options": {
     "queryReplacement": "={{ [ ($json.headers.authorization || '').replace(/^Bearer\\s+/i, '') ] }}"
    }
   }
  },
