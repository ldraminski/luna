     "name": "Oboe - Postgres (oboe-db)"
    }
   },
   "alwaysOutputData": false,
   "parameters": {
    "operation": "executeQuery",
    "query": "WITH d AS (DELETE FROM sessions WHERE token_hash = encode(digest($1, 'sha256'), 'hex') RETURNING 1)\nSELECT json_build_object('status', 200, 'ok', true) AS result",
