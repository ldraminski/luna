 "nodes": [
  {
   "id": "8a7627b8-9cda-4ecf-89db-2a4238c4b534",
   "name": "Opis",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    -400,
    -200
   ],
   "parameters": {
    "width": 520,
    "height": 220,
    "content": "## Oboe: API\nFront `oboe` (nginx) proxuje `/api/*` → `/webhook/oboe/*`.\nAutoryzacja: `Authorization: Bearer <token>`; w bazie tylko sha256 tokenu.\nHasła: bcrypt w Postgresie (pgcrypto `crypt`), bo Code node nie ma `crypto`.\nKażdy SQL zwraca `result` z polem `status` → kod HTTP odpowiedzi.\nŹródło: `~/Work/oboe/n8n/build_api.py`."
   }
  },
  {
   "id": "4482e24b-cb82-437b-a3b5-eeebaa849d50",
   "name": "POST login",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    0
   ],
   "webhookId": "6be4024b-ea15-4908-9074-224051f00835",
   "parameters": {
    "httpMethod": "POST",
    "path": "oboe/login",
    "responseMode": "responseNode",
    "options": {}
   }
  },
  {
   "id": "87abc6a1-8d6c-4222-be0f-2d53af274740",
   "name": "Logowanie",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.6,
   "position": [
    240,
    0
   ],
   "credentials": {
    "postgres": {
     "id": "IAfnl61Lb7KbTeZi",
     "name": "Oboe - Postgres (oboe-db)"
    }
   },
   "alwaysOutputData": false,
   "parameters": {
    "operation": "executeQuery",
    "query": "WITH recent AS (\n  SELECT count(*) AS n FROM login_attempts\n  WHERE email = lower($1) AND NOT ok AND created_at > now() - interval '15 minutes'),\nu AS (\n  SELECT id, email, name FROM users\n  WHERE email = lower($1) AND password_hash IS NOT NULL\n    AND password_hash = crypt($2, password_hash)\n    AND (SELECT n FROM recent) < 10),\nlog AS (\n  INSERT INTO login_attempts (email, ok) VALUES (lower($1), EXISTS (SELECT 1 FROM u))),\ntok AS (SELECT encode(gen_random_bytes(32), 'hex') AS t),\ns AS (\n  INSERT INTO sessions (token_hash, user_id, expires_at)\n  SELECT encode(digest((SELECT t FROM tok), 'sha256'), 'hex'), id, now() + interval '30 days' FROM u\n  RETURNING user_id)\nSELECT CASE\n  WHEN (SELECT n FROM recent) >= 10 THEN json_build_object('status', 429, 'error', 'Za dużo prób. Spróbuj za 15 minut.')\n  WHEN EXISTS (SELECT 1 FROM s) THEN json_build_object('status', 200, 'token', (SELECT t FROM tok),\n       'user', (SELECT json_build_object('email', email, 'name', name) FROM u))\n  ELSE json_build_object('status', 401, 'error', 'Zły e-mail albo hasło')\nEND AS result",
    "options": {
     "queryReplacement": "={{ [ String($json.body.email || '').trim().slice(0, 200), String($json.body.password || '').slice(0, 200) ] }}"
    }
   }
  },
  {
   "id": "dd22bca6-9d4e-4a04-8906-ddb7b2a8ec05",
   "name": "Odpowiedz: Logowanie",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.1,
   "position": [
    480,
